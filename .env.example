# Copy to .env and fill in locally. Do not commit .env.

# RunPod Serverless
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_API_BASE=https://api.runpod.ai/v2

# Cloudflare R2
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# GitHub Container Registry
GHCR_IMAGE=ghcr.io/<github-owner>/animatex-wan-worker
GHCR_TAG=0.1.0

